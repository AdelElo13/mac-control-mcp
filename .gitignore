.build/
.swiftpm/
*.xcodeproj/
DerivedData/

# Negate global ~/.gitignore_global "Icon?" rule that incorrectly matches
# .icns and .iconset paths (Finder uses literal "Icon\r" / "Icon?" stub
# files; this project ships proper .icns assets).
!assets/
!*.icns
!*.iconset/

# Release build outputs — regenerated by scripts/release.sh, attached to GitHub releases
release-artifacts/

# npm launcher package (npm/)
node_modules/
# The .app bundle downloaded by npm/scripts/install.js at postinstall time.
npm/vendor/
*.tgz
